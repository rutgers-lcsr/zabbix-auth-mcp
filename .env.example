# Public URL of this service exactly as MCP clients will use it (https, no
# trailing slash).
BASE_URL=https://zabbix-mcp.lcsr.rutgers.edu
# Name of the /etc/letsencrypt/live/<name> directory (the remotecert_compose_certs entry).
CERT_NAME=zabbix-mcp.lcsr.rutgers.edu
# The container's own public address on macvlan-vlan4 (128.6.4.0/24). Both the
# internal and the external DNS A record for BASE_URL's name point here.
IPV4_ADDRESS=128.6.4.31

# The Zabbix frontend that checks logins and issues the users' API tokens.
# zabbix-mcp-server has the same URL in zabbix-mcp/config.toml.
ZABBIX_URL=https://sarek.lcsr.rutgers.edu/zabbix

# Shared secret between this proxy and the zabbix-mcp-server container.
# Generate one with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MCP_BACKEND_TOKEN=change-me

# Optional, with their defaults:
# ALLOWED_USERS=            # comma-separated Zabbix usernames; empty = anyone with a Zabbix login
# ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1,blob.cs.rutgers.edu
# ZABBIX_TOKEN_HEADER=X-Zabbix-Token   # must match zabbix-mcp/config.toml
# ZABBIX_TOKEN_NAME=zabbix-auth-mcp    # prefix of the API token names created in Zabbix
# ACME_REDIRECT_URL=http://services.cs.rutgers.edu   # where port 80 sends Let's Encrypt challenges
# ACCESS_TOKEN_TTL=3600
# REFRESH_TOKEN_TTL=2592000  # also the lifetime of the Zabbix API token, extended on each refresh
